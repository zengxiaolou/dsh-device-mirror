{
  "name": "dsh-device-mirror",
  "version": "0.4.4",
  "type": "module",
  "description": "Live iOS Simulator / Android emulator mirror in the DSH sidebar and a floating overlay, with touch back-channel.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "engines": {
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "test": "node test/host.test.mjs && node test/client.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zengxiaolou/dsh-device-mirror"
  },
  "homepage": "https://github.com/zengxiaolou/dsh-device-mirror",
  "bugs": {
    "url": "https://github.com/zengxiaolou/dsh-device-mirror/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness"
  ],
  "license": "MIT"
}
